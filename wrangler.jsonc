{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ebs-revival",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ebs-revival-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "GAME", "class_name": "GameWorld" }
    ]
  },
  "exports": {
    "ChatRoom": { "type": "durable-object", "storage": "sqlite" },
    "GameWorld": { "type": "durable-object", "storage": "sqlite" }
  }
}
